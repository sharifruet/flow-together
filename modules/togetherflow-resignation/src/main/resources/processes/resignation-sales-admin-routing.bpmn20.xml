        <omgdi:waypoint x="1172.5" y="160"/>
        <omgdi:waypoint x="1235" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_toIbClearance" bpmnElement="toIbClearance">
