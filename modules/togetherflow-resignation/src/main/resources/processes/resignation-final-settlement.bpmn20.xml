        <omgdi:waypoint x="732.5" y="160"/>
        <omgdi:waypoint x="795" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_accManagerSigned" bpmnElement="accManagerSigned">
