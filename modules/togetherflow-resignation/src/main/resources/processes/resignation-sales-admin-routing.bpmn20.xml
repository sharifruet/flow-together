        <omgdi:waypoint x="1172.5" y="160"/>
        <omgdi:waypoint x="1235" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_toForwardClearance" bpmnElement="toForwardClearance">
        <omgdi:waypoint x="1275" y="160"/>
        <omgdi:waypoint x="1337.5" y="160"/>
        <omgdi:waypoint x="1337.5" y="160"/>
        <omgdi:waypoint x="1400" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_clearanceTrackToJoin" bpmnElement="clearanceTrackToJoin">
        <omgdi:waypoint x="1550" y="160"/>
        <omgdi:waypoint x="1612.5" y="160"/>
        <omgdi:waypoint x="1612.5" y="160"/>
        <omgdi:waypoint x="1675" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_toEndRouting" bpmnElement="toEndRouting">
        <omgdi:waypoint x="1715" y="160"/>
