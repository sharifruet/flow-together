        <omgdi:waypoint x="512.5" y="160"/>
        <omgdi:waypoint x="575" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_toDirectorSignature" bpmnElement="toDirectorSignature">
        <omgdi:waypoint x="615" y="160"/>
