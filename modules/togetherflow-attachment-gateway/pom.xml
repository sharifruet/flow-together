<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        flowable-parent, not flowable-root: `spring.boot.version` and the Spring
        dependency management every REST module relies on are declared there.
    -->
    <parent>
        <groupId>org.flowable</groupId>
        <artifactId>flowable-parent</artifactId>
        <version>8.1.0-SNAPSHOT</version>
        <relativePath>../flowable-parent</relativePath>
    </parent>

    <artifactId>togetherflow-attachment-gateway</artifactId>
    <packaging>jar</packaging>
    <name>TogetherFlow - Attachment Gateway</name>
    <description>
        Optional attachment storage gateway (REQUIREMENTS.md §7.6). Only deployed when a
        non-`db` provider is configured: with the default `db` provider the Work app
        posts straight to Flowable's own task-attachment endpoint and this module does
        not exist for that install.

        Uploads cannot go from the browser to SharePoint directly — app credentials
        would be exposed client-side — so this is a small server-side proxy that receives
        the file, stores it (filesystem or SharePoint via Microsoft Graph), and returns
        the URL the UI then registers with Flowable as an `externalUrl` attachment.
    </description>

    <properties>
        <flowable.artifact>org.togetherflow.attachments</flowable.artifact>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Spring Boot 4 split MockMvc's test auto-configuration out of the main test
            starter; @AutoConfigureMockMvc now lives in this artifact.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
