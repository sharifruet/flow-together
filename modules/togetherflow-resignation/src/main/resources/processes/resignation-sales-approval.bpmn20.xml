  <!--
      Resignation_Process.xlsx step 2 — "Resignation Approval & Sales Clearance".

      The resignation letter and the sales clearance travel together up the sales line:
      RSE -> ZSI -> SM -> GM. Every level approves both documents in one act, which is why
      there is one task per level rather than two.

      The spreadsheet describes only the happy path. A chain of four approvals with no way
      back would be unusable in practice, so each level can also return the record to the
      ASE who logged it; the ASE amends and the chain restarts at RSE. The decision is read
      with `variables:equals`, which is false for an absent variable, so a task completed
      without a decision returns rather than silently approving.
  -->
  <process id="salesResignationApproval" name="Sales Resignation Approval Chain" isExecutable="true">
    <documentation>Sequential approval of the resignation letter and the sales clearance by RSE, ZSI, SM and GM (Resignation_Process.xlsx step 2).</documentation>

    <startEvent id="startApproval" name="Forwarded by ASE"/>
    <sequenceFlow id="toRseApproval" sourceRef="startApproval" targetRef="rseApproval"/>

    <userTask id="rseApproval" name="RSE approval — resignation and sales clearance"
              flowable:candidateGroups="sales-rse" flowable:formKey="approvalDecisionForm">
      <documentation>Approve the resignation and the sales clearance, or return them to the ASE.</documentation>
    </userTask>
    <sequenceFlow id="toRseDecision" sourceRef="rseApproval" targetRef="rseDecision"/>

    <exclusiveGateway id="rseDecision" name="RSE decision" default="rseReturned"/>
    <sequenceFlow id="rseApproved" name="Approved" sourceRef="rseDecision" targetRef="notifyRseEntry">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${variables:equals(decision, 'approve')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="rseReturned" name="Returned" sourceRef="rseDecision" targetRef="aseAmendRecord"/>

    <!-- "RSE entry in mSales, generates notification mail to recipients" (step 2.2). -->
    <serviceTask id="notifyRseEntry" name="Notify recipients of the RSE entry"
                 flowable:expression="${resignationNotifier.send('RSE_APPROVED', employeeId, 'hrm,acc-officer,sales-ssr')}"/>
    <sequenceFlow id="toZsiApproval" sourceRef="notifyRseEntry" targetRef="zsiApproval"/>

    <userTask id="zsiApproval" name="ZSI approval — resignation and sales clearance"
              flowable:candidateGroups="sales-zsi" flowable:formKey="approvalDecisionForm"/>
    <sequenceFlow id="toZsiDecision" sourceRef="zsiApproval" targetRef="zsiDecision"/>

    <exclusiveGateway id="zsiDecision" name="ZSI decision" default="zsiReturned"/>
    <sequenceFlow id="zsiApproved" name="Approved" sourceRef="zsiDecision" targetRef="smApproval">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${variables:equals(decision, 'approve')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="zsiReturned" name="Returned" sourceRef="zsiDecision" targetRef="aseAmendRecord"/>

    <userTask id="smApproval" name="SM approval — resignation and sales clearance"
              flowable:candidateGroups="sales-sm" flowable:formKey="approvalDecisionForm"/>
    <sequenceFlow id="toSmDecision" sourceRef="smApproval" targetRef="smDecision"/>

    <exclusiveGateway id="smDecision" name="SM decision" default="smReturned"/>
    <sequenceFlow id="smApproved" name="Approved" sourceRef="smDecision" targetRef="gmApproval">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${variables:equals(decision, 'approve')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="smReturned" name="Returned" sourceRef="smDecision" targetRef="aseAmendRecord"/>

    <userTask id="gmApproval" name="GM approval — resignation and sales clearance"
              flowable:candidateGroups="sales-gm" flowable:formKey="approvalDecisionForm"/>
    <sequenceFlow id="toGmDecision" sourceRef="gmApproval" targetRef="gmDecision"/>

    <exclusiveGateway id="gmDecision" name="GM decision" default="gmReturned"/>
    <sequenceFlow id="gmApproved" name="Approved" sourceRef="gmDecision" targetRef="forwardToSalesAdmin">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${variables:equals(decision, 'approve')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="gmReturned" name="Returned" sourceRef="gmDecision" targetRef="aseAmendRecord"/>

    <!-- Step 2.4 — "GM Approval (Resignation & Clearance), FW to SSR (Sales Admin)". -->
    <serviceTask id="forwardToSalesAdmin" name="Forward both documents to SSR (Sales Admin)"
                 flowable:expression="${resignationNotifier.send('SALES_CHAIN_APPROVED', employeeId, 'sales-ssr')}"/>
    <sequenceFlow id="toEndApproval" sourceRef="forwardToSalesAdmin" targetRef="endApproval"/>

    <userTask id="aseAmendRecord" name="ASE — amend and resubmit the resignation record"
              flowable:assignee="${aseUserId}" flowable:formKey="resignationSubmissionForm">
      <documentation>A level in the chain returned the record. Correct it and resubmit; the chain restarts at RSE.</documentation>
    </userTask>
    <sequenceFlow id="toRseApprovalAgain" sourceRef="aseAmendRecord" targetRef="rseApproval"/>

    <endEvent id="endApproval" name="Approved by the sales line"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_salesResignationApproval">
