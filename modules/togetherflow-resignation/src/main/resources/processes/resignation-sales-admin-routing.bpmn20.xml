        <omgdi:waypoint x="925" y="160"/>
        <omgdi:waypoint x="960" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_letterTrackToJoin" bpmnElement="letterTrackToJoin">
