        <omgdi:waypoint x="677.5" y="160"/>
        <omgdi:waypoint x="740" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_toForwardLetter" bpmnElement="toForwardLetter">
