{
  "name": "@togetherflow/work",
  "version": "8.1.0-SNAPSHOT",
  "private": true,
  "description": "TogetherFlow Work — task and case inbox for business users.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --grep-invert @visual e2e/golden-path.spec.ts",
    "lint": "eslint . --max-warnings 0",
    "e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "budget": "node node_modules/@togetherflow/common/scripts/bundle-budget.mjs",
    "e2e:visual:docker": "docker run --rm --network host -v \"$PWD/../../../..:/repo\" -w /repo/togetherflow-work/src/main/frontend mcr.microsoft.com/playwright:v1.62.1-jammy npx playwright test --config=playwright.visual.config.ts"
  },
  "dependencies": {
    "@togetherflow/common": "file:../../../../togetherflow-common/src/main/frontend",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
