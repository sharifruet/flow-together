{
  "fields": [
    {
      "id": "submissionHeading",
      "name": "Resignation details",
      "type": "headline"
    },
    {
      "id": "initiator",
      "name": "Started by",
      "readOnly": true,
      "type": "text"
    },
    {
      "id": "employeeId",
      "name": "Employee ID",
      "required": true,
      "type": "text"
    },
    {
      "id": "employeeName",
      "name": "Employee name",
      "readOnly": true,
      "type": "text"
    },
    {
      "id": "resignationReason",
      "name": "Reason for resignation",
      "required": true,
      "type": "multi-line-text"
    },
    {
      "id": "lastWorkingDay",
      "name": "Proposed last working day",
      "required": true,
      "type": "date"
    },
    {
      "id": "resignationLetterAttached",
      "name": "Resignation letter attached?",
      "required": true,
      "type": "boolean"
    },
    {
      "id": "resignationLetter",
      "name": "Resignation letter",
      "params": {
        "accept": ".pdf,.doc,.docx,image/*",
        "maxFileSize": 10485760
      },
      "required": true,
      "type": "upload"
    }
  ],
  "key": "employeeSubmitForm",
  "name": "Employee (MPE)",
  "outcomes": [],
  "version": 3
}
