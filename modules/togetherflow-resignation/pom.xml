<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        flowable-parent, not flowable-root: `spring.boot.version` and the Spring dependency
        management the other TogetherFlow backend modules rely on are declared there.
    -->
    <parent>
        <groupId>org.flowable</groupId>
        <artifactId>flowable-parent</artifactId>
        <version>8.1.0-SNAPSHOT</version>
        <relativePath>../flowable-parent</relativePath>
    </parent>

    <artifactId>togetherflow-resignation</artifactId>
    <packaging>jar</packaging>
    <name>TogetherFlow - Resignation (Sales)</name>
    <description>
        The Resignation (Sales) case, its five processes, its forms and its app definition -
        the whole of docs/Resignation_Process.xlsx, modelled.

        A content module: what it ships is mostly not Java. `cases/` and `processes/` sit on
        Flowable's own autodeployment paths, so adding this jar to an application deploys the
        models. The Java is the small amount the models cannot express - the notifier and the
        document register they call, and an opt-in seeder for the sample people the case needs
        somebody to be.
    </description>

    <properties>
        <flowable.artifact>org.togetherflow.resignation</flowable.artifact>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            Supplied by the host application, which already runs these engines. The seeder
            writes through the process engine's IdentityService rather than the IDM one, so
            that a deployment which has the process engine has everything this needs.
        -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-engine</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
            The tests run the models on a real engine: a process engine with the CMMN engine
            configured onto it, which is the arrangement a CMMN process task needs, plus a
            standalone app engine for the one app definition.
        -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-cmmn-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-cmmn-engine-configurator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-app-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-reload4j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
