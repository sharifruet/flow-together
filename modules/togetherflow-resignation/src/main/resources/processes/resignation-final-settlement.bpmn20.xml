      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_hrmUpdateEbsRecord" bpmnElement="hrmUpdateEbsRecord">
        <omgdc:Bounds x="1400" y="120" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_headOfHrSettlementSignature" bpmnElement="headOfHrSettlementSignature">
        <omgdc:Bounds x="1620" y="120" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_completeFinalSettlement" bpmnElement="completeFinalSettlement">
        <omgdc:Bounds x="1840" y="120" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_registerSettlementDocument" bpmnElement="registerSettlementDocument">
        <omgdc:Bounds x="2060" y="120" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_sendFinalCopyToHrm" bpmnElement="sendFinalCopyToHrm">
        <omgdc:Bounds x="2280" y="120" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_endSettlement" bpmnElement="endSettlement">
        <omgdc:Bounds x="2560" y="145" width="30" height="30"/>
      </bpmndi:BPMNShape>
