        <omgdi:waypoint x="897.5" y="290"/>
        <omgdi:waypoint x="960" y="290"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_simuToJoin" bpmnElement="simuToJoin">
