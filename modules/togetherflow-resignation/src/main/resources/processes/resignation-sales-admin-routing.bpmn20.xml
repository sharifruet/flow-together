        <omgdi:waypoint x="1392.5" y="160"/>
        <omgdi:waypoint x="1392.5" y="160"/>
        <omgdi:waypoint x="1675" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_toClearanceFork" bpmnElement="toClearanceFork">
        <omgdi:waypoint x="615" y="160"/>
        <omgdi:waypoint x="705" y="160"/>
        <omgdi:waypoint x="705" y="290"/>
        <omgdi:waypoint x="795" y="290"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_toSimuClearance" bpmnElement="toSimuClearance">
